# ===== Banco de dados (obrigatório) =====
# PostgreSQL com extensão pgvector (use o docker-compose.yml incluso)
DATABASE_URL=postgres://pitaya:pitaya@localhost:5432/pitaya

# ===== Provedor de LLM (escolha um) =====
# Padrão de partida: provedor e modelo também se trocam pelo painel do chat
# (botão com o nome do modelo), que grava na tabela `configuracoes` e passa a
# ter precedência sobre o que está aqui. "Usar o do .env" no painel volta para
# estes valores.
#
# "anthropic", "openai", "openrouter" ou "nvidia"
LLM_PROVIDER=openrouter

# Chave do provedor escolhido. As chaves ficam SÓ aqui: o painel troca
# provedor e modelo, nunca segredo.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenRouter: uma chave para vários provedores (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# NVIDIA: modelos abertos hospedados por eles, chave gratuita e sem cartão em
# https://build.nvidia.com (começa com "nvapi-"). Cota própria, separada do
# OpenRouter — útil como plano B em demonstração. Ver docs/10-nvidia.md.
NVIDIA_API_KEY=

# Identificam o app nos rankings do OpenRouter. Opcionais.
OPENROUTER_SITE_NAME=IA Pitaya
OPENROUTER_SITE_URL=

# Modelo (opcional)
# Defaults: claude-opus-5 / gpt-4o / openai/gpt-4o (openrouter) /
# nvidia/nemotron-3-super-120b-a12b (nvidia)
# No OpenRouter o nome leva prefixo de provedor e precisa suportar tool
# calling: openai/gpt-4o, anthropic/claude-sonnet-4.5, google/gemini-2.5-pro.
LLM_MODEL=

# ===== Embeddings para RAG (opcional) =====
# Usa OpenAI text-embedding-3-small quando OPENAI_API_KEY está presente.
# Sem chave, a busca na base de conhecimento usa full-text (tsvector).
EMBEDDINGS_MODEL=text-embedding-3-small

# ===== APIs Embrapa / AgroAPI (opcional) =====
# Cadastro gratuito em https://www.agroapi.cnptia.embrapa.br
# Assine a API AGROFIT (plano Gratuito100KPorMes: 100 mil requisições/mês) e
# copie a Consumer Key e a Consumer Secret da sua aplicação.
#
# Preferido: o par abaixo renova o token sozinho — necessário para
# "npm run agrofit:sync", que leva mais tempo do que a validade de um token.
AGROAPI_CONSUMER_KEY=
AGROAPI_CONSUMER_SECRET=

# Alternativa: bearer já pronto, colado do portal. Expira em ~1h e não renova;
# serve para teste rápido. Também é o que habilita a tool Responde Agro.
AGROAPI_TOKEN=

AGROAPI_BASE_URL=https://api.cnptia.embrapa.br
# Endpoint de token (só mude se a Embrapa mudar o gateway).
AGROAPI_TOKEN_URL=https://api.cnptia.embrapa.br/token

# URL do CSV dos Dados Abertos Agrofit (produtos formulados) — confirme a URL
# atual em https://dados.agricultura.gov.br antes de importar.
AGROFIT_CSV_URL=
