# .env mínimo para rodar a aplicação só com a NVIDIA — o caminho de
# demonstração: chave gratuita, sem cartão, cota própria.
#
#   cp .env.nvidia.example .env     # e cole a chave abaixo
#   npm run db:up && npm run db:migrate && npm run db:seed
#   npm run llm:test                # confirma chave + tool calling
#   npm run dev
#
# Passo a passo da chave: docs/10-nvidia.md
# Todas as outras variáveis do projeto (Agrofit, ClimAPI, embeddings) são
# opcionais e estão em .env.example — sem elas o chat funciona com previsão do
# tempo, base de conhecimento em busca full-text e a cópia local do Agrofit.

# ===== Banco de dados (obrigatório) =====
# PostgreSQL com pgvector — sobe com "npm run db:up"
DATABASE_URL=postgres://pitaya:pitaya@localhost:5432/pitaya

# ===== NVIDIA (obrigatório aqui) =====
LLM_PROVIDER=nvidia

# Chave gerada em https://build.nvidia.com — começa com "nvapi-".
# Sem aspas e sem espaço em volta do "=".
NVIDIA_API_KEY=

# Opcional. Vazio usa nvidia/nemotron-3-super-120b-a12b.
# Precisa suportar tool calling; a lista curada está no painel do chat.
LLM_MODEL=

# Estes valores são só o padrão de partida: provedor e modelo também se trocam
# pelo painel do chat, que grava no banco e passa a ter precedência sobre este
# arquivo. "Usar o do .env" no painel devolve o controle para cá.
